{
  "name": "HealthRWA Local Blockchain",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py",
        "blockchain/contracts/ConsentSBT.sol"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "nomicfoundation.hardhat-solidity"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo xargs apt install -y < packages.txt || true; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; pip3 install --user streamlit; [ -f package.json ] && npm install; echo '✅ Python, Node.js and Hardhat dependencies installed'",
  "postAttachCommand": {
    "server": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Streamlit application",
      "onAutoForward": "openPreview"
    },
    "8545": {
      "label": "Hardhat JSON-RPC",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    8501,
    8545
  ]
}
